---
// Estilos globales disponibles en todo el portafolio
import '../styles/global.css';

// Navegación compartida entre las páginas del sitio
import Navbar from '../components/Navbar.astro';

// Propiedades  para personalizar los metadatos de cada página
interface Props {
	title?: string;
	description?: string;
}

const {
	title = 'Portafolio Profesional',
	description = 'Portafolio profesional de Ingeniería en Informática, desarrollo de software, datos y Business Intelligence.'
} = Astro.props;
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />

		<!-- Metadatos básicos para descripción e identificación de la página -->
		<meta name="description" content={description} />
		<meta name="generator" content={Astro.generator} />

		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />

		<title>{title}</title>
	</head>

	<body>

		<Navbar />

		<slot />
	</body>
</html>