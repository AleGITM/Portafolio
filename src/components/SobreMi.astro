
---
const lenguajes = [
  { nombre: 'Python', icono: '/icons/python.svg' },
  { nombre: 'JavaScript', icono: '/icons/javascript.svg' },
  { nombre: 'PHP', icono: '/icons/php.svg' },
  { nombre: 'MySQL', icono: '/icons/mysql.svg' },
];
---

<section
  id="sobre-mi"
  class="bg-[#02030a] px-6 py-24 sm:py-28"
>
  <div class="mx-auto max-w-6xl">

    <!-- Presentación profesional -->
    <div class="max-w-3xl">
      <p class="mb-3 text-sm font-medium uppercase tracking-[0.25em] text-pink-400">
      </p>

      <h2 class="text-4xl font-bold text-white sm:text-5xl">
        Sobre
        <span
          class="font-accent ml-2 text-pink-400 [text-shadow:0_0_20px_rgba(255,46,151,0.45)]"
        >
          mí
        </span>
      </h2>

      <div class="mt-8 space-y-5 text-base leading-relaxed text-gray-300 sm:text-lg">
        <p>
          Soy estudiante de cuarto año de Ingeniería en Informática en AIEP,
          con interés en el desarrollo de software y las distintas áreas de
          la tecnología.
        </p>

        <p>
          Durante mi formación académica he trabajado en proyectos de
          desarrollo web, programación, bases de datos y análisis de datos,
          aplicando los conocimientos adquiridos en distintas asignaturas.
        </p>
      </div>
    </div>

    <!-- Lenguajes y tecnologías -->
    <div class="mt-12 max-w-3xl">
      <h3 class="mb-5 text-sm font-semibold uppercase tracking-[0.2em] text-cyan-300">
       Tecnologías
      </h3>

      <div class="grid grid-cols-2 gap-3 sm:grid-cols-4">
        {lenguajes.map((lenguaje) => (
          <div
            class="flex min-h-28 flex-col items-center justify-center gap-3 rounded-xl border border-pink-500/20 bg-white/[0.03] p-4 transition-colors duration-200 hover:border-pink-400/60 hover:bg-white/[0.05]"
          >
            <img
              src={lenguaje.icono}
              alt=""
              aria-hidden="true"
              width="42"
              height="42"
              loading="lazy"
              class="h-10 w-10 object-contain"
            />

            <span class="text-center text-sm font-medium text-gray-200">
              {lenguaje.nombre}
            </span>
          </div>
        ))}
      </div>
    </div>

  </div>
</section>
