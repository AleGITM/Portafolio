
---
const lenguajes = [
  { nombre: 'Python', icono: '/icons/python.svg' },
  { nombre: 'JavaScript', icono: '/icons/javascript.svg' },
  { nombre: 'PHP', icono: '/icons/php.svg' },
  { nombre: 'MySQL', icono: '/icons/mysql.svg' },
];
---

<section
  id="sobre-mi"
  class="sobre-mi-section px-6 py-20 sm:py-24"
>
  <div class="mx-auto max-w-6xl">

    <!-- PRESENTACIÓN -->
    <div class="presentacion">
      <h2 class="titulo-sobre-mi text-4xl font-bold sm:text-5xl">
        Sobre
        <span class="nombre-acento font-accent ml-2">
          mí
        </span>
      </h2>

      <div class="descripcion-sobre-mi mt-8 space-y-5 text-base leading-relaxed sm:text-lg">
        <p>
          Soy estudiante de cuarto año de Ingeniería en Informática en AIEP,
          con interés en el desarrollo de software y las distintas áreas de
          la tecnología.
        </p>

        <p>
          Durante mi formación académica he trabajado en proyectos de
          desarrollo web, programación, bases de datos y análisis de datos,
          aplicando los conocimientos adquiridos en distintas asignaturas.
        </p>
      </div>
    </div>

    <!-- TECNOLOGÍAS Y GLITCH -->
    <div class="contenido-inferior">

      <div class="tecnologias-bloque">
        <h3 class="titulo-tecnologias mb-5 text-sm font-semibold uppercase tracking-[0.2em]">
          Tecnologías
        </h3>

        <div class="tecnologias-lista">
          {lenguajes.map((lenguaje) => (
            <div class="tecnologia-tarjeta">

              <!-- Luz sincronizada que recorre el borde -->
              <svg
                class="borde-animado"
                aria-hidden="true"
              >
                <rect
                  class="borde-luz"
                  x="2"
                  y="2"
                  rx="12"
                  ry="12"
                />
              </svg>

              <img
                src={lenguaje.icono}
                alt=""
                aria-hidden="true"
                width="42"
                height="42"
                loading="lazy"
                class="h-10 w-10 object-contain"
              />

              <span class="nombre-tecnologia text-base font-medium">
                {lenguaje.nombre}
              </span>
            </div>
          ))}
        </div>
      </div>

      <!-- Campo glitch interactivo -->
      <div
        class="glitch-campo"
        data-glitch-campo
        role="img"
        aria-label="Campo digital interactivo de píxeles neón"
      >
        <canvas class="glitch-canvas" aria-hidden="true"></canvas>
      </div>

    </div>
  </div>
</section>

<style>
  /* ==========================================
     MODO OSCURO ORIGINAL
     ========================================== */

  .sobre-mi-section {
    min-height: calc(100vh - 75px);
    overflow: hidden;
    background: #02030a;
    transition: background-color 0.3s ease;
  }

  .presentacion {
    max-width: 750px;
  }

  .titulo-sobre-mi {
    color: #ffffff;
  }

  .nombre-acento {
    color: #f472b6;
    text-shadow: 0 0 20px rgba(255, 46, 151, 0.45);
  }

  .descripcion-sobre-mi {
    color: #d1d5db;
  }

  .titulo-tecnologias {
    color: #67e8f9;
  }

  .contenido-inferior {
    display: grid;
    grid-template-columns: minmax(260px, 350px) minmax(0, 1fr);
    align-items: center;
    gap: clamp(2rem, 5vw, 5rem);
    margin-top: 3.5rem;
  }

  /* ==========================================
     TARJETAS DE TECNOLOGÍAS
     ========================================== */

  .tecnologias-lista {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.8rem;
  }

  .tecnologia-tarjeta {
    position: relative;
    display: flex;
    align-items: center;
    gap: 1.25rem;
    min-height: 76px;
    padding: 1rem 1.25rem;
    border: 1px solid rgba(236, 72, 153, 0.2);
    border-radius: 0.85rem;
    background: rgba(255, 255, 255, 0.025);
    isolation: isolate;

    transition:
      background-color 0.3s ease,
      border-color 0.3s ease;
  }

  .tecnologia-tarjeta > img,
  .tecnologia-tarjeta > span {
    position: relative;
    z-index: 2;
  }

  .nombre-tecnologia {
    color: #e5e7eb;
  }

  /* ==========================================
     BORDES LUMINOSOS SINCRONIZADOS
     ========================================== */

  .borde-animado {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    overflow: visible;
    pointer-events: none;
    z-index: 1;
  }

  .borde-luz {
    fill: none;
    stroke: #ff4eac;
    stroke-width: 2.5;
    stroke-linecap: round;
    vector-effect: non-scaling-stroke;

    filter:
      drop-shadow(0 0 4px #ff2e97)
      drop-shadow(0 0 8px rgba(255, 46, 151, 0.65));
  }

  .tecnologia-tarjeta:nth-child(even) .borde-luz {
    stroke: #67e8f9;

    filter:
      drop-shadow(0 0 4px #22d3ee)
      drop-shadow(0 0 8px rgba(34, 211, 238, 0.65));
  }

  /* ==========================================
     CAMPO GLITCH
     ========================================== */

  .glitch-campo {
    position: relative;
    width: 100%;
    height: 390px;
    min-width: 0;
    overflow: hidden;
    background: transparent;
    border: none;
    border-radius: 0;

    /* El cursor permanece invisible sobre el glitch */
    cursor: none;

    /* Permite la interacción táctil en móvil */
    touch-action: none;
  }

  .glitch-canvas {
    display: block;
    width: 100%;
    height: 100%;
    cursor: none;
    pointer-events: none;
  }

  /* ==========================================
     MODO CLARO
     ========================================== */

  :global(html.light) .sobre-mi-section {
    background: #f8fafc;
  }

  :global(html.light) .titulo-sobre-mi {
    color: #0f172a;
  }

  :global(html.light) .nombre-acento {
    color: #db2777;
    text-shadow: 0 0 18px rgba(219, 39, 119, 0.15);
  }

  :global(html.light) .descripcion-sobre-mi {
    color: #475569;
  }

  :global(html.light) .titulo-tecnologias {
    color: #0891b2;
  }

  :global(html.light) .tecnologia-tarjeta {
    background: rgba(255, 255, 255, 0.9);
    border-color: rgba(219, 39, 119, 0.2);
  }

  :global(html.light) .nombre-tecnologia {
    color: #1e293b;
  }

  /*
    Las luces rosa y cian conservan sus colores.
    El glitch también se mantiene transparente
    para integrarse con ambos fondos.
  */

  /* ==========================================
     RESPONSIVE ORIGINAL
     ========================================== */

  @media (max-width: 850px) {
    .contenido-inferior {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .tecnologias-lista {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .glitch-campo {
      height: 320px;
    }
  }

  @media (max-width: 480px) {
    .tecnologia-tarjeta {
      min-height: 70px;
      gap: 0.7rem;
      padding: 0.8rem;
    }

    .tecnologia-tarjeta img {
      width: 34px;
      height: 34px;
    }

    .tecnologia-tarjeta span {
      font-size: 0.85rem;
    }

    .glitch-campo {
      height: 260px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .sobre-mi-section,
    .tecnologia-tarjeta {
      transition: none;
    }

    .borde-luz {
      opacity: 0.45;
    }
  }
</style>

<script>
  /* ==========================================
     BORDES: UN SOLO RELOJ PARA LAS 4 LUCES
     ========================================== */

  function iniciarBordesAnimados() {
    const tarjetas = Array.from(
      document.querySelectorAll<HTMLElement>('.tecnologia-tarjeta')
    );

    if (!tarjetas.length) return;

    if (tarjetas[0].dataset.bordeIniciado === 'true') return;

    const movimientoReducido = window.matchMedia(
      '(prefers-reduced-motion: reduce)'
    ).matches;

    type Borde = {
      tarjeta: HTMLElement;
      rect: SVGRectElement;
      perimetro: number;
    };

    const bordes: Borde[] = [];

    tarjetas.forEach((tarjeta) => {
      const rect = tarjeta.querySelector<SVGRectElement>(
        '.borde-luz'
      );

      if (!rect) return;

      tarjeta.dataset.bordeIniciado = 'true';

      bordes.push({
        tarjeta,
        rect,
        perimetro: 0,
      });
    });

    if (!bordes.length) return;

    const DURACION = 5000;
    const SEGMENTO = 48;

    let frameId = 0;
    let destruido = false;

    // Las cuatro tarjetas comparten el mismo inicio.
    const inicio = performance.now();

    function ajustarBordes() {
      bordes.forEach((borde) => {
        const ancho = borde.tarjeta.clientWidth;
        const alto = borde.tarjeta.clientHeight;

        borde.rect.setAttribute(
          'width',
          String(Math.max(1, ancho - 4))
        );

        borde.rect.setAttribute(
          'height',
          String(Math.max(1, alto - 4))
        );

        const perimetro = borde.rect.getTotalLength();

        borde.perimetro = perimetro;

        borde.rect.style.strokeDasharray =
          `${SEGMENTO} ${Math.max(1, perimetro - SEGMENTO)}`;
      });
    }

    function animar(tiempo: number) {
      if (destruido || !bordes[0].tarjeta.isConnected) {
        frameId = 0;
        return;
      }

      // Todas avanzan al mismo porcentaje del perímetro.
      const progreso =
        ((tiempo - inicio) % DURACION) / DURACION;

      bordes.forEach((borde) => {
        if (!borde.perimetro) return;

        const radio = 12;
        const ajusteEsquina = radio * (Math.PI / 2 - 1);

        const desplazamiento =
          -(progreso * borde.perimetro + ajusteEsquina);

        borde.rect.style.strokeDashoffset =
          String(desplazamiento);
      });

      frameId = requestAnimationFrame(animar);
    }

    ajustarBordes();

    const observador = new ResizeObserver(ajustarBordes);

    bordes.forEach((borde) => {
      observador.observe(borde.tarjeta);
    });

    if (!movimientoReducido) {
      frameId = requestAnimationFrame(animar);
    }

    document.addEventListener(
      'astro:before-swap',
      () => {
        destruido = true;
        cancelAnimationFrame(frameId);
        observador.disconnect();
      },
      { once: true }
    );
  }

  /* ==========================================
     GLITCH DE CUADRADOS
     ========================================== */

  function iniciarCamposGlitch() {
    const campos = document.querySelectorAll<HTMLElement>(
      '[data-glitch-campo]'
    );

    campos.forEach((campo) => {
      if (campo.dataset.inicializado === 'true') return;

      const canvas = campo.querySelector<HTMLCanvasElement>(
        '.glitch-canvas'
      );

      const contexto = canvas?.getContext('2d');

      if (!canvas || !contexto) return;

      campo.dataset.inicializado = 'true';

      const ctx = contexto;

      const movimientoReducido = window.matchMedia(
        '(prefers-reduced-motion: reduce)'
      ).matches;

      type Fragmento = {
        x: number;
        y: number;
        origenX: number;
        origenY: number;
        vx: number;
        vy: number;
        ancho: number;
        alto: number;
        color: string;
        alpha: number;
        alphaBase: number;
        fase: number;
        velocidad: number;
        tipo: number;
      };

      const colores = [
        '#ec4899',
        '#f472b6',
        '#67e8f9',
        '#22d3ee',
        '#a855f7',
      ];

      const aleatorio = (min: number, max: number) =>
        min + Math.random() * (max - min);

      let ancho = 1;
      let alto = 1;
      let fragmentos: Fragmento[] = [];

      let mouseX = -1000;
      let mouseY = -1000;
      let mouseDentro = false;

      let frameId = 0;
      let ultimoTiempo = 0;
      let activo = false;
      let destruido = false;

      let siguienteRafaga = 0;
      let desplazamientoRafaga = 0;
      let franjaRafaga = 0;

      function crearFragmento(): Fragmento {
        const x = aleatorio(0, ancho);
        const y = aleatorio(0, alto);

        const tipo = Math.random();

        const tamano =
          tipo > 0.94
            ? aleatorio(14, 24)
            : tipo > 0.65
              ? aleatorio(7, 13)
              : aleatorio(2, 6);

        return {
          x,
          y,
          origenX: x,
          origenY: y,
          vx: 0,
          vy: 0,
          ancho: tamano,
          alto: tamano,
          color: colores[Math.floor(Math.random() * colores.length)],
          alpha: aleatorio(0, 0.3),
          alphaBase: aleatorio(0.35, 0.95),
          fase: aleatorio(0, Math.PI * 2),
          velocidad: aleatorio(0.6, 3),
          tipo,
        };
      }

      function ajustarCanvas() {
        const rect = campo.getBoundingClientRect();

        ancho = Math.max(1, rect.width);
        alto = Math.max(1, rect.height);

        const dpr = Math.min(window.devicePixelRatio || 1, 2);

        canvas.width = Math.round(ancho * dpr);
        canvas.height = Math.round(alto * dpr);

        ctx.setTransform(dpr, 0, 0, dpr, 0, 0);

        const cantidad = Math.min(
          620,
          Math.max(220, Math.floor((ancho * alto) / 360))
        );

        fragmentos = Array.from(
          { length: cantidad },
          crearFragmento
        );

        if (movimientoReducido) {
          fragmentos.forEach((fragmento) => {
            fragmento.alpha = fragmento.alphaBase;
          });

          dibujar(0);
        }
      }

      function dibujar(tiempo: number) {
        ctx.clearRect(0, 0, ancho, alto);

        for (const f of fragmentos) {
          if (f.alpha < 0.015) continue;

          const parpadeo =
            Math.sin(tiempo * 0.008 * f.velocidad + f.fase);

          const opacidad = Math.max(
            0,
            Math.min(1, f.alpha * (0.7 + parpadeo * 0.3))
          );

          let desplazamientoX = 0;

          if (
            desplazamientoRafaga !== 0 &&
            Math.abs(f.y - franjaRafaga) < 22
          ) {
            desplazamientoX = desplazamientoRafaga;
          }

          ctx.globalAlpha = opacidad;
          ctx.fillStyle = f.color;

          ctx.fillRect(
            Math.round(f.x + desplazamientoX),
            Math.round(f.y),
            f.ancho,
            f.alto
          );
        }

        ctx.globalAlpha = 1;
      }

      function actualizar(tiempo: number) {
        if (!activo || destruido || !campo.isConnected) {
          frameId = 0;
          return;
        }

        const delta = ultimoTiempo
          ? Math.min((tiempo - ultimoTiempo) / 16.67, 2)
          : 1;

        ultimoTiempo = tiempo;

        // Ráfagas de interferencia.
        if (tiempo > siguienteRafaga) {
          franjaRafaga = aleatorio(0, alto);
          desplazamientoRafaga = aleatorio(-55, 55);

          siguienteRafaga = tiempo + aleatorio(100, 420);
        }

        desplazamientoRafaga *= Math.pow(0.85, delta);

        for (const f of fragmentos) {
          const dx = f.x - mouseX;
          const dy = f.y - mouseY;
          const distancia = Math.hypot(dx, dy);

          const radio = 115;
          const cerca = mouseDentro && distancia < radio;

          // Dispersión al acercar el mouse o tocar.
          if (cerca) {
            const fuerza = 1 - distancia / radio;
            const angulo = Math.atan2(dy, dx);

            f.vx += Math.cos(angulo) * fuerza * 4.5 * delta;
            f.vy += Math.sin(angulo) * fuerza * 3.2 * delta;
          }

          // Retorno a la posición original.
          f.vx += (f.origenX - f.x) * 0.012 * delta;
          f.vy += (f.origenY - f.y) * 0.012 * delta;

          f.vx *= Math.pow(0.87, delta);
          f.vy *= Math.pow(0.87, delta);

          f.x += f.vx * delta;
          f.y += f.vy * delta;

          // Desaparecer cerca del puntero y regenerarse.
          const distanciaOrigen = Math.hypot(
            f.origenX - mouseX,
            f.origenY - mouseY
          );

          const ocultar =
            mouseDentro && distanciaOrigen < radio;

          const alphaObjetivo = ocultar ? 0 : f.alphaBase;
          const suavizado = ocultar ? 0.22 : 0.035;

          f.alpha +=
            (alphaObjetivo - f.alpha) *
            Math.min(suavizado * delta, 1);

          // Glitches individuales.
          if (Math.random() < 0.025 * delta) {
            f.x += aleatorio(-28, 28);
          }

          if (Math.random() < 0.012 * delta) {
            f.y += aleatorio(-8, 8);
          }

          if (Math.random() < 0.003 * delta) {
            f.origenX = Math.max(
              0,
              Math.min(ancho, f.origenX + aleatorio(-25, 25))
            );

            f.origenY = Math.max(
              0,
              Math.min(alto, f.origenY + aleatorio(-15, 15))
            );
          }
        }

        dibujar(tiempo);
        frameId = requestAnimationFrame(actualizar);
      }

      /* ==========================================
         INTERACCIÓN MOUSE Y TÁCTIL
         ========================================== */

      function actualizarPosicion(evento: PointerEvent) {
        const rect = campo.getBoundingClientRect();

        mouseX = evento.clientX - rect.left;
        mouseY = evento.clientY - rect.top;
        mouseDentro = true;
      }

      function iniciarContacto(evento: PointerEvent) {
        if (evento.pointerType === 'mouse') {
          actualizarPosicion(evento);
          return;
        }

        campo.setPointerCapture(evento.pointerId);
        actualizarPosicion(evento);
      }

      function moverPuntero(evento: PointerEvent) {
        // Mouse sin clic; touch al pulsar y arrastrar.
        if (
          evento.pointerType === 'mouse' ||
          evento.buttons > 0
        ) {
          actualizarPosicion(evento);
        }
      }

      function salirPuntero(evento: PointerEvent) {
        if (evento.pointerType === 'mouse') {
          mouseDentro = false;
          mouseX = -1000;
          mouseY = -1000;
        }
      }

      function terminarContacto(evento: PointerEvent) {
        if (evento.pointerType === 'mouse') return;

        mouseDentro = false;
        mouseX = -1000;
        mouseY = -1000;

        if (campo.hasPointerCapture(evento.pointerId)) {
          campo.releasePointerCapture(evento.pointerId);
        }
      }

      function iniciar() {
        if (movimientoReducido || destruido || activo) return;

        activo = true;
        ultimoTiempo = 0;
        frameId = requestAnimationFrame(actualizar);
      }

      function detener() {
        activo = false;
        cancelAnimationFrame(frameId);
        frameId = 0;
      }

      ajustarCanvas();

      if (!movimientoReducido) {
        campo.addEventListener('pointerdown', iniciarContacto);
        campo.addEventListener('pointermove', moverPuntero);
        campo.addEventListener('pointerleave', salirPuntero);
        campo.addEventListener('pointerup', terminarContacto);
        campo.addEventListener('pointercancel', terminarContacto);
      }

      const observadorTamaño = new ResizeObserver(ajustarCanvas);
      observadorTamaño.observe(campo);

      const observadorVisibilidad = new IntersectionObserver(
        (entradas) => {
          if (entradas[0]?.isIntersecting) {
            iniciar();
          } else {
            detener();
          }
        },
        { threshold: 0.05 }
      );

      observadorVisibilidad.observe(campo);

      document.addEventListener(
        'astro:before-swap',
        () => {
          destruido = true;
          detener();
          observadorTamaño.disconnect();
          observadorVisibilidad.disconnect();
        },
        { once: true }
      );
    });
  }

  /* ==========================================
     INICIALIZACIÓN COMPATIBLE CON ASTRO
     ========================================== */

  function iniciarSobreMi() {
    iniciarBordesAnimados();
    iniciarCamposGlitch();
  }

  document.addEventListener(
    'astro:page-load',
    iniciarSobreMi
  );

  if (document.readyState === 'loading') {
    document.addEventListener(
      'DOMContentLoaded',
      iniciarSobreMi,
      { once: true }
    );
  } else {
    iniciarSobreMi();
  }
</script>
