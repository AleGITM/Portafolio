---
// Enlaces profesionales mostrados en la sección de contacto
const contactos = [
	{
		etiqueta: "Correo",
		valor: "Guillermo.munozva@correoiep.cl",
		href: "mailto:Guillermo.munozva@correoiep.cl",
		externo: false,
	},
	{
		etiqueta: "GitHub",
		valor: "github.com/AleGITM",
		href: "https://github.com/AleGITM",
		externo: true,
	},
];
---

<section
	id="contacto"
	class="relative overflow-hidden bg-[#02030a] px-6 py-24 sm:py-28"
>
	<div
		class="pointer-events-none absolute -left-40 bottom-0 h-96 w-96 rounded-full bg-cyan-400/10 blur-[130px]"
	></div>

	<div class="relative z-10 mx-auto max-w-6xl">
		<p class="mb-3 text-sm font-medium uppercase tracking-[0.25em] text-pink-400">
			Contacto
		</p>

		<h2 class="text-4xl font-bold text-white sm:text-5xl">
			Mis medios de
			<span
				class="font-accent ml-2 text-pink-400 [text-shadow:0_0_20px_rgba(255,46,151,0.45)]"
			>
				contacto
			</span>
		</h2>

		<p class="mt-6 text-base text-gray-300 sm:text-lg">
			Puedes encontrarme a través de:
		</p>

		<!-- Medios de contacto ordenados verticalmente -->
		<ul class="mt-10 max-w-2xl space-y-4">
			{
				contactos.map((contacto) => (
					<li>
						<a
							href={contacto.href}
							target={contacto.externo ? "_blank" : undefined}
							rel={contacto.externo ? "noopener noreferrer" : undefined}
							class="group block rounded-xl border border-white/10 bg-white/[0.03] p-6 transition hover:border-pink-500/50 hover:bg-white/[0.06]"
						>
							<p class="text-xs font-semibold uppercase tracking-[0.2em] text-cyan-300">
								{contacto.etiqueta}
							</p>

							<p class="mt-2 break-all text-lg font-medium text-white transition group-hover:text-pink-400">
								{contacto.valor}
							</p>
						</a>
					</li>
				))
			}
		</ul>
	</div>
</section>