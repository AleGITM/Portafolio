---
const fuentes = [
  { nombre: 'SII', detalle: 'Actividad económica por comuna, 2005–2024.' },
  { nombre: 'CONAF', detalle: 'Incendios forestales durante 40 temporadas.' },
  { nombre: 'DGA', detalle: 'Caudales mensuales de cinco estaciones, 2015–2024.' },
  { nombre: 'ODEPA', detalle: 'Precios mayoristas agrícolas de O’Higgins.' },
  { nombre: 'ODEPA–CIREN', detalle: 'Catastro Frutícola 2024.' },
];

const archivos = {
  notebook: '/archivos/colchagua.ipynb',
  datasets: '/archivos/datasets-colchagua.zip',
  powerbi: '/archivos/colchagua.pbix',
  informe: '/archivos/informe-colchagua.pdf',
};

const graficos = [
  {
    src: '/graficos/incendios_anuales.png',
    categoria: 'Análisis temporal',
    titulo: 'Incendios por año',
    descripcion: 'Evolución de la frecuencia de incendios forestales registrados entre 1985 y 2024.',
    alt: 'Gráfico de incendios forestales por año de término.',
  },
  {
    src: '/graficos/superficie_anual.png',
    categoria: 'Análisis temporal',
    titulo: 'Superficie quemada por año',
    descripcion: 'La superficie afectada varía considerablemente entre años, con un máximo destacado en 2017.',
    alt: 'Gráfico de superficie afectada por incendios según año de término.',
  },
  {
    src: '/graficos/superficie_comunas.png',
    categoria: 'Comparación territorial',
    titulo: 'Superficie quemada por comuna',
    descripcion: 'Pumanque registra la mayor superficie quemada acumulada del periodo analizado.',
    alt: 'Gráfico de superficie quemada acumulada por comuna de Colchagua.',
  },
  {
    src: '/graficos/catastro_fruticola.png',
    categoria: 'Comparación territorial',
    titulo: 'Catastro Frutícola 2024',
    descripcion: 'Comparación de indicadores de superficie de cerezos y riego por goteo entre comunas.',
    alt: 'Gráfico comparativo de indicadores del Catastro Frutícola 2024.',
  },
];

const cifras = [
  { valor: '10', etiqueta: 'Comunas analizadas' },
  { valor: '5', etiqueta: 'Fuentes oficiales' },
  { valor: '40', etiqueta: 'Temporadas de incendios' },
  { valor: '3', etiqueta: 'Perfiles comunales' },
];

const etapas = [
  'Datos y Datamart',
  'Análisis exploratorio',
  'Machine Learning',
  'Forecast',
  'Power BI',
];
---

<section id="proyectos" class="proyectos-section px-6 py-20 sm:py-28">
  <div class="mx-auto max-w-6xl">

    <!-- TÍTULO -->
    <header class="max-w-4xl">
      <h1 class="text-3xl font-bold leading-tight text-white sm:text-5xl">
        Resiliencia Económica del Territorio Agrícola de{' '}
        <span class="font-accent text-pink-400 [text-shadow:0_0_20px_rgba(255,46,151,0.35)]">
          Colchagua
        </span>
      </h1>
    </header>

    <!-- CONTEXTO -->
    <article class="mt-16 max-w-4xl">
      <h2 class="text-2xl font-bold text-white sm:text-3xl">
        Contexto y problema
      </h2>

      <p class="mt-6 text-base leading-8 text-gray-300">
        La provincia de Colchagua mantiene una importante relación con la
        actividad agrícola. Esta investigación analiza las diferencias entre
        sus comunas mediante información económica, agrícola y ambiental,
        con especial atención a la exposición histórica a incendios forestales.
      </p>

      <div class="mt-8 border-l-2 border-pink-400/70 pl-5">
        <p class="text-xs font-semibold uppercase tracking-[0.2em] text-pink-400">
          Pregunta de investigación
        </p>

        <p class="mt-3 text-lg leading-relaxed text-white">
          ¿Qué diferencias territoriales pueden identificarse frente a
          las amenazas que afectan a la actividad agrícola de Colchagua?
        </p>
      </div>
    </article>

    <!-- INVESTIGACIÓN -->
    <section class="mt-24" aria-labelledby="desarrollo-titulo">
      <h2 id="desarrollo-titulo" class="text-2xl font-bold text-white sm:text-3xl">
        Investigación, desarrollo y conclusiones
      </h2>

      <p class="mt-4 max-w-3xl leading-7 text-gray-400">
        Explora las principales etapas de la investigación y sus resultados.
      </p>

      <div class="colchagua-panel mt-9" data-tabs-root>

        <!-- NAVEGACIÓN ENTRE ETAPAS -->
        <nav class="colchagua-tabs" aria-label="Etapas de la investigación" role="tablist">
          {etapas.map((etapa, index) => (
            <button
              type="button"
              role="tab"
              id={`etapa-tab-${index}`}
              aria-controls={`etapa-${index}`}
              aria-selected={index === 0 ? 'true' : 'false'}
              tabindex={index === 0 ? 0 : -1}
              data-tab={index}
              class:list={{ 'is-active': index === 0 }}
            >
              <span>{String(index + 1).padStart(2, '0')}</span> {etapa}
            </button>
          ))}
        </nav>

        <div class="colchagua-content">

          <!-- ETAPA 1: DATOS Y DATAMART -->
          <section
            id="etapa-0"
            role="tabpanel"
            aria-labelledby="etapa-tab-0"
            data-panel="0"
          >
            <p class="colchagua-kicker">01 / Preparación de datos</p>
            <h3 class="colchagua-heading">Datos y Datamart</h3>

            <p class="colchagua-copy">
              Se integraron cinco fuentes oficiales mediante Python y
              procesos ETL. La información se limpió, normalizó y organizó
              en un Datamart, respetando las diferencias de cobertura
              temporal y geográfica de cada fuente.
            </p>

            <h4 class="colchagua-subheading">Fuentes utilizadas</h4>

            <div class="divide-y divide-white/10 border-y border-white/10">
              {fuentes.map((fuente) => (
                <div class="grid gap-2 py-3 sm:grid-cols-[145px_1fr] sm:gap-5">
                  <span class="font-mono text-sm text-cyan-300">
                    {fuente.nombre}
                  </span>
                  <p class="text-sm leading-6 text-gray-300">
                    {fuente.detalle}
                  </p>
                </div>
              ))}
            </div>

            <div class="colchagua-downloads">
              <h4 class="colchagua-subheading">Archivos de esta etapa</h4>

              <a class="colchagua-download" href={archivos.datasets} download>
                <span class="colchagua-extension">.zip</span>
                <span>
                  <strong>Datasets</strong>
                  <small>Datos utilizados en la investigación</small>
                </span>
                <span aria-hidden="true">↗</span>
              </a>

              <a class="colchagua-download" href={archivos.notebook} download>
                <span class="colchagua-extension">.ipynb</span>
                <span>
                  <strong>Notebook de investigación</strong>
                  <small>ETL, Datamart y análisis</small>
                </span>
                <span aria-hidden="true">↗</span>
              </a>
            </div>
          </section>

          <!-- ETAPA 2: ANÁLISIS EXPLORATORIO -->
          <section
            id="etapa-1"
            role="tabpanel"
            aria-labelledby="etapa-tab-1"
            data-panel="1"
            hidden
          >
            <p class="colchagua-kicker">02 / Exploración de datos</p>
            <h3 class="colchagua-heading">Análisis exploratorio</h3>

            <p class="colchagua-copy">
              Se exploraron los registros de incendios y la información
              agrícola para identificar patrones, valores extremos y
              diferencias entre comunas antes de aplicar los modelos analíticos.
            </p>

            <!-- CARRUSEL DE GRÁFICOS -->
            <div
              class="grafico-carrusel mt-9"
              data-graficos-root
              aria-label="Gráficos del análisis exploratorio"
              aria-roledescription="carrusel"
            >
              <div class="grafico-cabecera">
                <p class="grafico-cabecera-titulo">
                  Visualizaciones del análisis
                </p>

                <span data-grafico-counter class="font-mono text-xs text-gray-400">
                  01 / 04
                </span>
              </div>

              <div class="grafico-visor">
                {graficos.map((grafico, index) => (
                  <figure
                    class="grafico-slide"
                    data-grafico-slide
                    aria-label={`Gráfico ${index + 1} de ${graficos.length}`}
                    hidden={index !== 0}
                  >
                    <div class="grafico-imagen">
                      <img
                        src={grafico.src}
                        alt={grafico.alt}
                        loading="lazy"
                      />
                    </div>

                    <figcaption class="grafico-descripcion">
                      <p class="grafico-categoria">{grafico.categoria}</p>
                      <h4 class="grafico-titulo">{grafico.titulo}</h4>
                      <p class="grafico-texto">{grafico.descripcion}</p>
                    </figcaption>
                  </figure>
                ))}
              </div>

              <div class="grafico-controles">
                <button
                  type="button"
                  class="grafico-boton"
                  data-grafico-prev
                  aria-label="Ver gráfico anterior"
                >
                  <span aria-hidden="true">←</span>
                  Anterior
                </button>

                <div class="grafico-indicadores" aria-label="Seleccionar gráfico">
                  {graficos.map((grafico, index) => (
                    <button
                      type="button"
                      class:list={[
                        'grafico-indicador',
                        { 'is-active': index === 0 },
                      ]}
                      data-grafico-dot={index}
                      aria-label={`Ver gráfico ${index + 1}: ${grafico.titulo}`}
                      aria-current={index === 0 ? 'true' : undefined}
                    />
                  ))}
                </div>

                <button
                  type="button"
                  class="grafico-boton"
                  data-grafico-next
                  aria-label="Ver gráfico siguiente"
                >
                  Siguiente
                  <span aria-hidden="true">→</span>
                </button>
              </div>
            </div>

            <div class="colchagua-downloads">
              <a class="colchagua-download" href={archivos.notebook} download>
                <span class="colchagua-extension">.ipynb</span>
                <span>
                  <strong>Ver análisis completo</strong>
                  <small>Notebook con código y visualizaciones</small>
                </span>
                <span aria-hidden="true">↗</span>
              </a>
            </div>
          </section>

          <!-- ETAPA 3: MACHINE LEARNING -->
          <section
            id="etapa-2"
            role="tabpanel"
            aria-labelledby="etapa-tab-2"
            data-panel="2"
            hidden
          >
            <p class="colchagua-kicker">03 / Agrupamiento territorial</p>
            <h3 class="colchagua-heading">Machine Learning</h3>

            <p class="colchagua-copy">
              Se aplicó clustering jerárquico para identificar similitudes
              entre las diez comunas. Se obtuvieron tres perfiles
              territoriales con un coeficiente silhouette de 0,314.
              Son agrupaciones exploratorias, no un ranking definitivo
              de vulnerabilidad.
            </p>

            <h4 class="colchagua-subheading">Perfiles identificados</h4>

            <div class="perfiles-lista">
              <div class="perfil-fila">
                <span class="perfil-numero">01</span>
                <div>
                  <h4>Chimbarongo y San Fernando</h4>
                  <p>
                    Mayor superficie de cerezos y frecuencia histórica
                    de incendios.
                  </p>
                </div>
              </div>

              <div class="perfil-fila">
                <span class="perfil-numero">02</span>
                <div>
                  <h4>Chépica, Nancagua, Palmilla y Placilla</h4>
                  <p>
                    Mayor dependencia relativa del empleo agrícola
                    y menor exposición histórica a incendios.
                  </p>
                </div>
              </div>

              <div class="perfil-fila">
                <span class="perfil-numero">03</span>
                <div>
                  <h4>Lolol, Peralillo, Pumanque y Santa Cruz</h4>
                  <p>
                    Mayor superficie quemada acumulada y menor
                    peso relativo del empleo agrícola.
                  </p>
                </div>
              </div>
            </div>

            <div class="colchagua-downloads">
              <a class="colchagua-download" href={archivos.notebook} download>
                <span class="colchagua-extension">.ipynb</span>
                <span>
                  <strong>Ver modelo completo</strong>
                  <small>Clustering y evaluación</small>
                </span>
                <span aria-hidden="true">↗</span>
              </a>
            </div>
          </section>

          <!-- ETAPA 4: FORECAST -->
          <section
            id="etapa-3"
            role="tabpanel"
            aria-labelledby="etapa-tab-3"
            data-panel="3"
            hidden
          >
            <p class="colchagua-kicker">04 / Pronóstico temporal</p>
            <h3 class="colchagua-heading">Forecast</h3>

            <p class="colchagua-copy">
              Se compararon tres métodos para pronosticar incendios
              forestales por temporada. La persistencia obtuvo el menor
              error en la evaluación y se utilizó para proyectar
              80 incendios por temporada durante los tres periodos siguientes.
            </p>

            <h4 class="colchagua-subheading">Comparación de modelos</h4>

            <div class="overflow-x-auto border-y border-white/10">
              <table class="w-full border-collapse text-left text-sm">
                <thead>
                  <tr class="border-b border-white/10 text-xs uppercase tracking-wider text-cyan-300">
                    <th class="py-4 pr-5 font-medium">Modelo</th>
                    <th class="py-4 font-medium">MAE</th>
                  </tr>
                </thead>

                <tbody class="text-gray-300">
                  <tr class="border-b border-white/10">
                    <td class="py-4 pr-5 text-white">Persistencia</td>
                    <td class="py-4 font-mono text-pink-400">17,33</td>
                  </tr>
                  <tr class="border-b border-white/10">
                    <td class="py-4 pr-5">Promedio histórico</td>
                    <td class="py-4 font-mono">19,18</td>
                  </tr>
                  <tr>
                    <td class="py-4 pr-5">Holt</td>
                    <td class="py-4 font-mono">28,51</td>
                  </tr>
                </tbody>
              </table>
            </div>

            <div class="mt-8 border-l-2 border-cyan-300/50 pl-5">
              <p class="font-mono text-4xl text-white">80</p>
              <p class="mt-2 text-sm text-gray-300">
                Incendios proyectados por temporada:
                2024–25, 2025–26 y 2026–27.
              </p>
              <p class="mt-3 text-sm leading-7 text-gray-400">
                Proyección exploratoria basada en el último valor observado,
                sin incorporar variables climáticas.
              </p>
            </div>

            <div class="colchagua-downloads">
              <a class="colchagua-download" href={archivos.notebook} download>
                <span class="colchagua-extension">.ipynb</span>
                <span>
                  <strong>Ver pronóstico completo</strong>
                  <small>Modelos y evaluación</small>
                </span>
                <span aria-hidden="true">↗</span>
              </a>
            </div>
          </section>

          <!-- ETAPA 5: POWER BI -->
          <section
            id="etapa-4"
            role="tabpanel"
            aria-labelledby="etapa-tab-4"
            data-panel="4"
            hidden
          >
            <p class="colchagua-kicker">05 / Visualización y resultados</p>
            <h3 class="colchagua-heading">Power BI y conclusiones</h3>

            <p class="colchagua-copy">
              Se desarrolló un dashboard para visualizar los indicadores
              económicos, agrícolas y ambientales de Colchagua y facilitar
              la comparación territorial.
            </p>

            <figure class="dashboard-figura mt-8 overflow-hidden border border-white/10 bg-[#0a1020]">
              <img
                src="/imagenes/dashboard-colchagua.png"
                alt="Dashboard de Power BI sobre Colchagua"
                class="h-auto w-full"
                loading="lazy"
              />
              <figcaption class="border-t border-white/10 px-4 py-3 text-xs text-gray-400">
                Dashboard desarrollado en Power BI Desktop.
              </figcaption>
            </figure>

            <h4 class="colchagua-subheading">Principales conclusiones</h4>

            <div class="conclusiones-lista">
              <p>
                <span>01</span>
                San Fernando registra la mayor frecuencia histórica de
                incendios, mientras que Pumanque presenta la mayor
                superficie quemada.
              </p>
              <p>
                <span>02</span>
                Las comunas presentan perfiles agrícolas y ambientales
                diferentes, por lo que no es adecuado evaluarlas
                mediante un único indicador.
              </p>
              <p>
                <span>03</span>
                Los resultados sirven como base descriptiva para apoyar
                decisiones territoriales, pero no demuestran causalidad
                ni cuantifican directamente pérdidas económicas de las PYMEs.
              </p>
            </div>

            <div class="colchagua-downloads">
              <h4 class="colchagua-subheading">Archivos del proyecto</h4>

              <a class="colchagua-download" href={archivos.powerbi} download>
                <span class="colchagua-extension">.pbix</span>
                <span>
                  <strong>Dashboard Power BI</strong>
                  <small>Archivo para Power BI Desktop</small>
                </span>
                <span aria-hidden="true">↗</span>
              </a>

              <a class="colchagua-download" href={archivos.informe} download>
                <span class="colchagua-extension">.pdf</span>
                <span>
                  <strong>Informe de investigación</strong>
                  <small>Metodología y resultados completos</small>
                </span>
                <span aria-hidden="true">↗</span>
              </a>
            </div>
          </section>
        </div>

        <!-- CONTROLES DE ETAPAS -->
        <div class="colchagua-controls">
          <span data-counter class="font-mono text-xs text-gray-500">
            01 / 05
          </span>

          <div class="flex gap-5">
            <button
              type="button"
              data-prev
              aria-label="Etapa anterior"
              class="colchagua-arrow"
            >←</button>

            <button
              type="button"
              data-next
              aria-label="Etapa siguiente"
              class="colchagua-arrow"
            >→</button>
          </div>
        </div>
      </div>
    </section>

    <!-- CIFRAS -->
    <section class="mt-24" aria-labelledby="cifras-titulo">
      <h2 id="cifras-titulo" class="text-2xl font-bold text-white sm:text-3xl">
        La investigación en cifras
      </h2>

      <p class="mt-4 max-w-3xl leading-7 text-gray-400">
        Una síntesis del alcance y los principales hallazgos del estudio.
      </p>

      <div class="cifras-grid mt-9">
        {cifras.map((cifra) => (
          <div class="cifra-item">
            <p class="font-mono text-4xl text-pink-400 sm:text-5xl">
              {cifra.valor}
            </p>
            <p class="mt-3 text-sm text-gray-300">
              {cifra.etiqueta}
            </p>
          </div>
        ))}
      </div>

      <div class="mt-9 max-w-4xl border-l-2 border-cyan-300/60 pl-5">
        <p class="text-sm font-medium text-cyan-300">
          Hallazgo destacado
        </p>

        <p class="mt-3 leading-8 text-gray-300">
          San Fernando acumuló <strong class="text-white">1.056 incendios</strong>,
          mientras que Pumanque registró aproximadamente
          <strong class="text-white">57.774 hectáreas quemadas</strong>.
          La frecuencia y la superficie afectada representan
          dimensiones distintas de exposición territorial.
        </p>
      </div>
    </section>
  </div>
</section>

<style>
  /* ==========================================
     FONDO GENERAL
     ========================================== */

  .proyectos-section {
    background: #050817;
    transition: background-color 300ms ease;
  }

  /* ==========================================
     PANEL PRINCIPAL
     ========================================== */

  .colchagua-panel {
    position: relative;
    isolation: isolate;
    background: #050817;
    border-top: 1px solid rgba(103, 232, 249, 0.25);
    border-bottom: 1px solid rgba(148, 163, 184, 0.16);
    transform: none !important;
    transition:
      border-color 300ms ease,
      box-shadow 300ms ease,
      background-color 300ms ease;
  }

  /*
    El destello es un borde real de 1 px.
    No cubre ni oscurece el contenido.
  */
  .colchagua-panel::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 2;
    width: auto;
    height: auto;
    pointer-events: none;
    border: 1px solid transparent;
    background:
      linear-gradient(#050817, #050817) padding-box,
      conic-gradient(
        from var(--neon-angle, 0deg),
        transparent 0deg,
        transparent 260deg,
        rgba(236, 72, 153, 0.15) 290deg,
        #ec4899 320deg,
        #f9a8d4 330deg,
        transparent 350deg
      ) border-box;
    opacity: 0;
    transition: opacity 300ms ease;
  }

  .colchagua-panel::after {
    display: none;
  }

  .colchagua-panel > * {
    position: relative;
    z-index: 3;
  }

  @property --neon-angle {
    syntax: '<angle>';
    initial-value: 0deg;
    inherits: false;
  }

  @keyframes colchagua-neon-recorrido {
    to {
      --neon-angle: 360deg;
    }
  }

  /* ==========================================
     PESTAÑAS
     ========================================== */

  .colchagua-tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.75rem;
    padding: 1.5rem 1.5rem 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .colchagua-tabs button {
    position: relative;
    padding: 0 0 1.15rem;
    color: #94a3b8;
    font-size: 0.78rem;
    line-height: 1.6;
    text-align: left;
    cursor: pointer;
    transition:
      color 200ms ease,
      transform 200ms ease,
      text-shadow 200ms ease;
  }

  .colchagua-tabs button span {
    margin-right: 0.4rem;
    color: #64748b;
    font-family: monospace;
  }

  .colchagua-tabs button:hover,
  .colchagua-tabs button.is-active {
    color: #f9a8d4;
  }

  .colchagua-tabs button.is-active::after {
    content: '';
    position: absolute;
    right: 0;
    bottom: -1px;
    left: 0;
    height: 2px;
    background: #ec4899;
  }

  .colchagua-content {
    padding: 2rem 1.5rem 2.5rem;
  }

  .colchagua-kicker {
    margin-bottom: 0.8rem;
    color: #67e8f9;
    font-family: monospace;
    font-size: 0.72rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .colchagua-heading {
    margin-bottom: 1.5rem;
    color: #fff;
    font-size: clamp(1.45rem, 3vw, 2rem);
    font-weight: 700;
    line-height: 1.25;
  }

  .colchagua-copy {
    max-width: 56rem;
    color: #d1d5db;
    line-height: 1.85;
  }

  .colchagua-subheading {
    margin: 2rem 0 1rem;
    color: #f9a8d4;
    font-size: 1rem;
    font-weight: 600;
  }

  /* ==========================================
     CARRUSEL DE GRÁFICOS
     ========================================== */

  .grafico-carrusel {
    max-width: 850px;
    margin-inline: auto;
    overflow: hidden;
    border: 1px solid rgba(103, 232, 249, 0.22);
    background: #080e20;
    transition:
      border-color 240ms ease,
      box-shadow 240ms ease,
