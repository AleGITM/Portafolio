---
const fuentes = [
  { nombre: 'SII', detalle: 'Actividad económica por comuna, 2005–2024.' },
  { nombre: 'CONAF', detalle: 'Incendios forestales durante 40 temporadas.' },
  { nombre: 'DGA', detalle: 'Caudales mensuales de cinco estaciones, 2015–2024.' },
  { nombre: 'ODEPA', detalle: 'Precios mayoristas agrícolas de O’Higgins.' },
  { nombre: 'ODEPA–CIREN', detalle: 'Catastro Frutícola 2024.' },
];

const archivos = {
  datasets: '/archivos/Datasets.zip',
  notebooks: '/archivos/Notebooks.zip',
  exploratorio: '/archivos/Analisis_Exploratorio.ipynb',
  ml: '/archivos/ML_SEGMENTACION.ipynb',
  forecast: '/archivos/FORECAST.ipynb',
  powerbi: '/archivos/DashboardColch.pbix',
};

const cifras = [
  { valor: '10', etiqueta: 'Comunas analizadas' },
  { valor: '5', etiqueta: 'Fuentes oficiales' },
  { valor: '40', etiqueta: 'Temporadas de incendios' },
  { valor: '3', etiqueta: 'Perfiles comunales' },
];

const etapas = [
  'Datos y Datamart',
  'Análisis exploratorio',
  'Machine Learning',
  'Forecast',
  'Power BI',
];
---

<section id="proyectos" class="proyectos-section px-6 py-20 sm:py-28">
  <div class="mx-auto max-w-6xl">

    <!-- TÍTULO -->
    <header class="max-w-4xl">
      <h1 class="text-3xl font-bold leading-tight text-white sm:text-5xl">
        Resiliencia Económica del Territorio Agrícola de{' '}
        <span class="font-accent text-pink-400 [text-shadow:0_0_20px_rgba(255,46,151,0.35)]">
          Colchagua
        </span>
      </h1>
    </header>

    <!-- CONTEXTO -->
    <article class="mt-16 max-w-4xl">
      <h2 class="text-2xl font-bold text-white sm:text-3xl">
        Contexto y problema
      </h2>

      <p class="mt-6 text-base leading-8 text-gray-300">
        La provincia de Colchagua mantiene una importante relación con la
        actividad agrícola. Esta investigación analiza las diferencias entre
        sus comunas mediante información económica, agrícola y ambiental,
        con especial atención a la exposición histórica a incendios forestales.
      </p>

      <div class="mt-8 border-l-2 border-pink-400/70 pl-5">
        <p class="text-xs font-semibold uppercase tracking-[0.2em] text-pink-400">
          Pregunta de investigación
        </p>

        <p class="mt-3 text-lg leading-relaxed text-white">
          ¿Qué diferencias territoriales pueden identificarse frente a
          las amenazas que afectan a la actividad agrícola de Colchagua-?
        </p>
      </div>
    </article>

    <!-- INVESTIGACIÓN -->
    <section class="mt-24" aria-labelledby="desarrollo-titulo">
      <h2 id="desarrollo-titulo" class="text-2xl font-bold text-white sm:text-3xl">
        Investigación, desarrollo y conclusiones
      </h2>

      <p class="mt-4 max-w-3xl leading-7 text-gray-400">
        Explora las etapas del estudio, desde la preparación de datos
        hasta la presentación de resultados.
      </p>

      <div class="colchagua-panel mt-9" data-tabs-root>

        <!-- NAVEGACIÓN ENTRE ETAPAS -->
        <nav
          class="colchagua-tabs"
          aria-label="Etapas de la investigación"
          role="tablist"
        >
          {etapas.map((etapa, index) => (
            <button
              type="button"
              role="tab"
              id={`etapa-tab-${index}`}
              aria-controls={`etapa-${index}`}
              aria-selected={index === 0 ? 'true' : 'false'}
              tabindex={index === 0 ? 0 : -1}
              data-tab={index}
              class:list={{ 'is-active': index === 0 }}
            >
              <span>{String(index + 1).padStart(2, '0')}</span>
              {etapa}
            </button>
          ))}
        </nav>

        <div class="colchagua-content">

          <!-- ETAPA 1: DATOS Y DATAMART -->
          <section
            id="etapa-0"
            role="tabpanel"
            aria-labelledby="etapa-tab-0"
            data-panel="0"
          >
            <p class="colchagua-kicker">01 / Preparación de datos</p>
            <h3 class="colchagua-heading">Datos y Datamart</h3>

            <p class="colchagua-copy">
              Se integraron cinco fuentes oficiales mediante Python y
              procesos ETL. La información se limpió, normalizó y organizó
              en un Datamart, respetando las diferencias de cobertura
              temporal y geográfica de cada fuente.
            </p>

            <h4 class="colchagua-subheading">Fuentes utilizadas</h4>

            <div class="fuentes-lista">
              {fuentes.map((fuente) => (
                <div class="fuente-fila">
                  <span class="fuente-nombre">{fuente.nombre}</span>
                  <p>{fuente.detalle}</p>
                </div>
              ))}
            </div>

            <div class="colchagua-downloads">
              <h4 class="colchagua-subheading">Archivos de investigación</h4>

              <a class="colchagua-download" href={archivos.datasets} download>
                <span class="colchagua-extension">.zip</span>
                <span>
                  <strong>Datasets</strong>
                  <small>Datos utilizados en la investigación</small>
                </span>
                <span aria-hidden="true">↗</span>
              </a>

              <a class="colchagua-download" href={archivos.notebooks} download>
                <span class="colchagua-extension">.zip</span>
                <span>
                  <strong>Notebooks del proyecto</strong>
                  <small>Conjunto de cuadernos de investigación</small>
                </span>
                <span aria-hidden="true">↗</span>
              </a>
            </div>
          </section>

          <!-- ETAPA 2: ANÁLISIS EXPLORATORIO -->
          <section
            id="etapa-1"
            role="tabpanel"
            aria-labelledby="etapa-tab-1"
            data-panel="1"
            hidden
          >
            <p class="colchagua-kicker">02 / Exploración de datos</p>
            <h3 class="colchagua-heading">Análisis exploratorio</h3>

            <p class="colchagua-copy">
              Se examinaron los registros de incendios forestales y los
              indicadores agrícolas para reconocer patrones temporales,
              diferencias entre comunas y valores extremos.
              Esta exploración permitió comprender las características
              de los datos antes de desarrollar los modelos analíticos.
            </p>

            <h4 class="colchagua-subheading">Aspectos investigados</h4>

            <div class="analisis-lista">
              <div class="analisis-fila">
                <span class="analisis-numero">01</span>
                <div>
                  <h4>Evolución de incendios forestales</h4>
                  <p>
                    Se estudió su frecuencia histórica y la variación
                    de la superficie afectada entre temporadas.
                  </p>
                </div>
              </div>

              <div class="analisis-fila">
                <span class="analisis-numero">02</span>
                <div>
                  <h4>Diferencias entre comunas</h4>
                  <p>
                    Se compararon indicadores territoriales para
                    identificar distintos niveles de exposición
                    y características productivas.
                  </p>
                </div>
              </div>

              <div class="analisis-fila">
                <span class="analisis-numero">03</span>
                <div>
                  <h4>Actividad agrícola</h4>
                  <p>
                    Se revisó información del sector agrícola,
                    incluyendo indicadores del Catastro Frutícola
                    y otras fuentes oficiales.
                  </p>
                </div>
              </div>
            </div>

            <p class="colchagua-nota">
              El análisis detallado, el código y las visualizaciones
              originales se encuentran en el notebook de análisis exploratorio.
            </p>

            <div class="colchagua-downloads">
              <a class="colchagua-download" href={archivos.exploratorio} download>
                <span class="colchagua-extension">.ipynb</span>
                <span>
                  <strong>Descargar análisis exploratorio</strong>
                  <small>Notebook con código y visualizaciones</small>
                </span>
                <span aria-hidden="true">↗</span>
              </a>
            </div>
          </section>

          <!-- ETAPA 3: MACHINE LEARNING -->
          <section
            id="etapa-2"
            role="tabpanel"
            aria-labelledby="etapa-tab-2"
            data-panel="2"
            hidden
          >
            <p class="colchagua-kicker">03 / Agrupamiento territorial</p>
            <h3 class="colchagua-heading">Machine Learning</h3>

            <p class="colchagua-copy">
              Se aplicó clustering jerárquico para identificar similitudes
              entre las diez comunas. Se obtuvieron tres perfiles
              territoriales con un coeficiente silhouette de 0,314.
              Son agrupaciones exploratorias, no un ranking definitivo
              de vulnerabilidad.
            </p>

            <h4 class="colchagua-subheading">Perfiles identificados</h4>

            <div class="perfiles-lista">
              <div class="perfil-fila">
                <span class="perfil-numero">01</span>
                <div>
                  <h4>Chimbarongo y San Fernando</h4>
                  <p>
                    Mayor superficie de cerezos y frecuencia histórica
                    de incendios.
                  </p>
                </div>
              </div>

              <div class="perfil-fila">
                <span class="perfil-numero">02</span>
                <div>
                  <h4>Chépica, Nancagua, Palmilla y Placilla</h4>
                  <p>
                    Mayor dependencia relativa del empleo agrícola
                    y menor exposición histórica a incendios.
                  </p>
                </div>
              </div>

              <div class="perfil-fila">
                <span class="perfil-numero">03</span>
                <div>
                  <h4>Lolol, Peralillo, Pumanque y Santa Cruz</h4>
                  <p>
                    Mayor superficie quemada acumulada y menor
                    peso relativo del empleo agrícola.
                  </p>
                </div>
              </div>
            </div>

            <div class="colchagua-downloads">
              <a class="colchagua-download" href={archivos.ml} download>
                <span class="colchagua-extension">.ipynb</span>
                <span>
                  <strong>Descargar modelo Machine Learning</strong>
                  <small>Clustering y evaluación de resultados</small>
                </span>
                <span aria-hidden="true">↗</span>
              </a>
            </div>
          </section>

          <!-- ETAPA 4: FORECAST -->
          <section
            id="etapa-3"
            role="tabpanel"
            aria-labelledby="etapa-tab-3"
            data-panel="3"
            hidden
          >
            <p class="colchagua-kicker">04 / Pronóstico temporal</p>
            <h3 class="colchagua-heading">Forecast</h3>

            <p class="colchagua-copy">
              Se compararon tres métodos para pronosticar incendios
              forestales por temporada. La persistencia obtuvo el menor
              error en la evaluación y se utilizó para proyectar
              80 incendios por temporada durante los tres periodos siguientes.
            </p>

            <h4 class="colchagua-subheading">Comparación de modelos</h4>

            <div class="modelos-tabla">
              <table>
                <thead>
                  <tr>
                    <th>Modelo</th>
                    <th>MAE</th>
                  </tr>
                </thead>
                <tbody>
                  <tr>
                    <td>Persistencia</td>
                    <td class="modelo-destacado">17,33</td>
                  </tr>
                  <tr>
                    <td>Promedio histórico</td>
                    <td>19,18</td>
                  </tr>
                  <tr>
                    <td>Holt</td>
                    <td>28,51</td>
                  </tr>
                </tbody>
              </table>
            </div>

            <div class="pronostico-destacado">
              <p class="pronostico-valor">80</p>
              <p class="pronostico-descripcion">
                Incendios proyectados por temporada:
                2024–25, 2025–26 y 2026–27.
              </p>
              <p class="pronostico-nota">
                Proyección exploratoria basada en el último valor
                observado, sin incorporar variables climáticas.
              </p>
            </div>

            <div class="colchagua-downloads">
              <a class="colchagua-download" href={archivos.forecast} download>
                <span class="colchagua-extension">.ipynb</span>
                <span>
                  <strong>Descargar pronóstico completo</strong>
                  <small>Modelos y evaluación</small>
                </span>
                <span aria-hidden="true">↗</span>
              </a>
            </div>
          </section>

          <!-- ETAPA 5: POWER BI -->
          <section
            id="etapa-4"
            role="tabpanel"
            aria-labelledby="etapa-tab-4"
            data-panel="4"
            hidden
          >
            <p class="colchagua-kicker">05 / Visualización y resultados</p>
            <h3 class="colchagua-heading">Power BI</h3>

            <p class="colchagua-copy">
              Se desarrolló un dashboard en Power BI Desktop para
              visualizar los indicadores económicos, agrícolas y
              ambientales de Colchagua, facilitando su interpretación
              y comparación territorial.
            </p>

            <div class="colchagua-downloads">
              <h4 class="colchagua-subheading">Archivo del dashboard</h4>

              <a class="colchagua-download" href={archivos.powerbi} download>
                <span class="colchagua-extension">.pbix</span>
                <span>
                  <strong>Descargar dashboard Power BI</strong>
                  <small>Archivo para Power BI Desktop</small>
                </span>
                <span aria-hidden="true">↗</span>
              </a>
            </div>
          </section>

        </div>

        <!-- CONTROLES DEL CARRUSEL -->
        <div class="colchagua-controls">
          <span data-counter class="font-mono text-xs text-gray-500">
            01 / 05
          </span>

          <div class="flex gap-5">
            <button
              type="button"
              data-prev
              aria-label="Etapa anterior"
              class="colchagua-arrow"
            >←</button>

            <button
              type="button"
              data-next
              aria-label="Etapa siguiente"
              class="colchagua-arrow"
            >→</button>
          </div>
        </div>

      </div>
    </section>

    <!-- CIFRAS -->
    <section class="mt-24" aria-labelledby="cifras-titulo">
      <h2 id="cifras-titulo" class="text-2xl font-bold text-white sm:text-3xl">
        La investigación en cifras
      </h2>

      <p class="mt-4 max-w-3xl leading-7 text-gray-400">
        Una síntesis del alcance y los principales hallazgos del estudio.
      </p>

      <div class="cifras-grid mt-9">
        {cifras.map((cifra) => (
          <div class="cifra-item">
            <p class="font-mono text-4xl text-pink-400 sm:text-5xl">
              {cifra.valor}
            </p>
            <p class="mt-3 text-sm text-gray-300">
              {cifra.etiqueta}
            </p>
          </div>
        ))}
      </div>

      <div class="hallazgo-destacado">
        <p class="hallazgo-titulo">Hallazgo destacado</p>

        <p class="hallazgo-texto">
          San Fernando acumuló <strong>1.056 incendios</strong>,
          mientras que Pumanque registró aproximadamente
          <strong> 57.774 hectáreas quemadas</strong>.
          La frecuencia y la superficie afectada representan
          dimensiones distintas de exposición territorial.
        </p>
      </div>
    </section>

  </div>
</section>

<style>
  /* FONDO GENERAL */
  .proyectos-section {
    background: #050817;
    transition: background-color 300ms ease;
  }

  /* PANEL PRINCIPAL */
  .colchagua-panel {
    position: relative;
    isolation: isolate;
    background: #050817;
    border-top: 1px solid rgba(103, 232, 249, 0.25);
    border-bottom: 1px solid rgba(148, 163, 184, 0.16);
    transform: none !important;
    transition:
      border-color 300ms ease,
      box-shadow 300ms ease,
      background-color 300ms ease;
  }

  .colchagua-panel::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 2;
    pointer-events: none;
    border: 1px solid transparent;
    background:
      linear-gradient(#050817, #050817) padding-box,
      conic-gradient(
        from var(--neon-angle, 0deg),
        transparent 0deg,
        transparent 260deg,
        rgba(236, 72, 153, 0.15) 290deg,
        #ec4899 320deg,
        #f9a8d4 330deg,
        transparent 350deg
      ) border-box;
    opacity: 0;
    transition: opacity 300ms ease;
  }

  .colchagua-panel::after {
    display: none;
  }

  .colchagua-panel > * {
    position: relative;
    z-index: 3;
  }

  @property --neon-angle {
    syntax: '<angle>';
    initial-value: 0deg;
    inherits: false;
  }

  @keyframes colchagua-neon-recorrido {
    to {
      --neon-angle: 360deg;
    }
  }

  /* PESTAÑAS */
  .colchagua-tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.75rem;
    padding: 1.5rem 1.5rem 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .colchagua-tabs button {
    position: relative;
    padding: 0 0 1.15rem;
    color: #94a3b8;
    font-size: 0.78rem;
    line-height: 1.6;
    text-align: left;
    cursor: pointer;
    transition:
      color 200ms ease,
      transform 200ms ease,
      text-shadow 200ms ease;
  }

  .colchagua-tabs button span {
    margin-right: 0.4rem;
    color: #64748b;
    font-family: monospace;
  }

  .colchagua-tabs button:hover,
  .colchagua-tabs button.is-active {
    color: #f9a8d4;
  }

  .colchagua-tabs button.is-active::after {
    content: '';
    position: absolute;
    right: 0;
    bottom: -1px;
    left: 0;
    height: 2px;
    background: #ec4899;
  }

  .colchagua-content {
    padding: 2rem 1.5rem 2.5rem;
  }

  .colchagua-kicker {
    margin-bottom: 0.8rem;
    color: #67e8f9;
    font-family: monospace;
    font-size: 0.72rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .colchagua-heading {
    margin-bottom: 1.5rem;
    color: #fff;
    font-size: clamp(1.45rem, 3vw, 2rem);
    font-weight: 700;
    line-height: 1.25;
  }

  .colchagua-copy {
    max-width: 56rem;
    color: #d1d5db;
    line-height: 1.85;
  }

  .colchagua-subheading {
    margin: 2rem 0 1rem;
    color: #f9a8d4;
    font-size: 1rem;
    font-weight: 600;
  }

  /* FUENTES DE DATOS */
  .fuentes-lista {
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }

  .fuente-fila {
    display: grid;
    gap: 0.5rem;
    padding: 0.8rem 0;
  }

  .fuente-fila + .fuente-fila {
    border-top: 1px solid rgba(255, 255, 255, 0.1);
  }

  .fuente-nombre {
    color: #67e8f9;
    font-family: monospace;
    font-size: 0.875rem;
  }

  .fuente-fila p {
    color: #d1d5db;
    font-size: 0.875rem;
    line-height: 1.6;
  }

  /* ANÁLISIS EXPLORATORIO Y PERFILES */
  .analisis-lista,
  .perfiles-lista {
    border-top: 1px solid rgba(255, 255, 255, 0.1);
  }

  .analisis-fila,
  .perfil-fila {
    display: grid;
    grid-template-columns: 36px minmax(0, 1fr);
    gap: 1rem;
    padding: 1.25rem 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }

  .analisis-numero,
  .perfil-numero {
    color: #f472b6;
    font-family: monospace;
    font-size: 0.85rem;
  }

  .analisis-fila h4,
  .perfil-fila h4 {
    color: #fff;
    font-size: 0.95rem;
    font-weight: 600;
  }

  .analisis-fila p,
  .perfil-fila p {
    margin-top: 0.35rem;
    color: #9ca3af;
    font-size: 0.85rem;
    line-height: 1.7;
  }

  .colchagua-nota {
    margin-top: 1.5rem;
    max-width: 48rem;
    color: #94a3b8;
    font-size: 0.875rem;
    line-height: 1.8;
  }

  /* FORECAST */
  .modelos-tabla {
    max-width: 48rem;
    overflow-x: auto;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }

  .modelos-tabla table {
    width: 100%;
    border-collapse: collapse;
    text-align: left;
    font-size: 0.875rem;
  }

  .modelos-tabla th {
    padding: 1rem 1.25rem 1rem 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    color: #67e8f9;
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .modelos-tabla td {
    padding: 1rem 1.25rem 1rem 0;
    color: #d1d5db;
  }

  .modelos-tabla tbody tr:not(:last-child) {
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }

  .modelos-tabla .modelo-destacado {
    color: #f472b6;
    font-family: monospace;
  }

  .pronostico-destacado {
    margin-top: 2rem;
    padding-left: 1.25rem;
    border-left: 2px solid rgba(103, 232, 249, 0.5);
  }

  .pronostico-valor {
    color: #fff;
    font-family: monospace;
    font-size: 2.25rem;
  }

  .pronostico-descripcion {
    margin-top: 0.5rem;
    color: #d1d5db;
    font-size: 0.875rem;
    line-height: 1.7;
  }

  .pronostico-nota {
    margin-top: 0.75rem;
    color: #9ca3af;
    font-size: 0.875rem;
    line-height: 1.7;
  }

  /* CIFRAS */
  .cifras-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 2rem 1.5rem;
    padding: 2rem 0;
    border-top: 1px solid rgba(103, 232, 249, 0.25);
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }

  .cifra-item {
    min-width: 0;
  }

  .hallazgo-destacado {
    max-width: 56rem;
    margin-top: 2.25rem;
    padding-left: 1.25rem;
    border-left: 2px solid rgba(103, 232, 249, 0.6);
  }

  .hallazgo-titulo {
    color: #67e8f9;
    font-size: 0.875rem;
    font-weight: 500;
  }

  .hallazgo-texto {
    margin-top: 0.75rem;
    color: #d1d5db;
    line-height: 2;
  }

  .hallazgo-texto strong {
    color: #fff;
  }

  /* DESCARGAS */
  .colchagua-downloads {
    margin-top: 2.5rem;
    max-width: 48rem;
  }

  .colchagua-download {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    padding: 1.1rem 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
