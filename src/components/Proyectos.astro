<script>
  /* ==========================================
     NAVEGACIÓN ENTRE LAS CINCO ETAPAS
     ========================================== */

  function iniciarCarruseles() {
    document.querySelectorAll<HTMLElement>('[data-tabs-root]').forEach((root) => {
      if (root.dataset.initialized === 'true') return;

      root.dataset.initialized = 'true';

      const tabs = Array.from(
        root.querySelectorAll<HTMLButtonElement>('[data-tab]')
      );

      const panels = Array.from(
        root.querySelectorAll<HTMLElement>('[data-panel]')
      );

      const counter = root.querySelector<HTMLElement>('[data-counter]');
      const prev = root.querySelector<HTMLButtonElement>('[data-prev]');
      const next = root.querySelector<HTMLButtonElement>('[data-next]');

      if (!tabs.length || tabs.length !== panels.length) return;

      let current = 0;

      function mostrar(index: number, focusTab = false) {
        current = (index + tabs.length) % tabs.length;

        tabs.forEach((tab, i) => {
          const active = i === current;

          tab.classList.toggle('is-active', active);
          tab.setAttribute('aria-selected', String(active));
          tab.tabIndex = active ? 0 : -1;

          if (active && focusTab) tab.focus();
        });

        panels.forEach((panel, i) => {
          panel.hidden = i !== current;
        });

        if (counter) {
          counter.textContent =
            `${String(current + 1).padStart(2, '0')} / ${String(tabs.length).padStart(2, '0')}`;
        }
      }

      tabs.forEach((tab, index) => {
        tab.addEventListener('click', () => mostrar(index));

        tab.addEventListener('keydown', (event) => {
          if (event.key === 'ArrowRight') {
            event.preventDefault();
            mostrar(current + 1, true);
          } else if (event.key === 'ArrowLeft') {
            event.preventDefault();
            mostrar(current - 1, true);
          } else if (event.key === 'Home') {
            event.preventDefault();
            mostrar(0, true);
          } else if (event.key === 'End') {
            event.preventDefault();
            mostrar(tabs.length - 1, true);
          }
        });
      });

      prev?.addEventListener('click', () => mostrar(current - 1));
      next?.addEventListener('click', () => mostrar(current + 1));

      mostrar(0);
    });
  }

  /* ==========================================
     CARRUSEL DE GRÁFICOS DEL ANÁLISIS
     ========================================== */

  function iniciarCarruselGraficos() {
    document.querySelectorAll<HTMLElement>('[data-graficos-root]').forEach((root) => {
      if (root.dataset.initialized === 'true') return;

      root.dataset.initialized = 'true';

      const slides = Array.from(
        root.querySelectorAll<HTMLElement>('[data-grafico-slide]')
      );

      const dots = Array.from(
        root.querySelectorAll<HTMLButtonElement>('[data-grafico-dot]')
      );

      const counter = root.querySelector<HTMLElement>('[data-grafico-counter]');
      const prev = root.querySelector<HTMLButtonElement>('[data-grafico-prev]');
      const next = root.querySelector<HTMLButtonElement>('[data-grafico-next]');
      const visor = root.querySelector<HTMLElement>('.grafico-visor');

      if (!slides.length || !visor) return;

      let current = 0;
      let animando = false;
      let touchStartX = 0;
      let touchStartY = 0;

      const duracion = 420;

      const reducirMovimiento = window.matchMedia(
        '(prefers-reduced-motion: reduce)'
      );

      function actualizarControles() {
        dots.forEach((dot, i) => {
          const active = i === current;
          dot.classList.toggle('is-active', active);

          if (active) {
            dot.setAttribute('aria-current', 'true');
          } else {
            dot.removeAttribute('aria-current');
          }
        });

        if (counter) {
          counter.textContent =
            `${String(current + 1).padStart(2, '0')} / ${String(slides.length).padStart(2, '0')}`;
        }
      }

      function mostrar(index: number, direccionForzada?: number) {
        if (animando) return;

        const siguiente = (index + slides.length) % slides.length;

        if (siguiente === current) return;

        const anterior = current;
        const slideAnterior = slides[anterior];
        const slideSiguiente = slides[siguiente];

        const direccion =
          direccionForzada ?? (siguiente > anterior ? 1 : -1);

        current = siguiente;
        actualizarControles();

        if (reducirMovimiento.matches) {
          slideAnterior.hidden = true;
          slideSiguiente.hidden = false;
          return;
        }

        animando = true;

        const alturaInicial = visor.getBoundingClientRect().height;
        visor.style.height = `${alturaInicial}px`;

        slideSiguiente.hidden = false;

        slideAnterior.classList.add('grafico-saliendo');
        slideSiguiente.classList.add('grafico-entrando');

        // Desplazamiento horizontal y opacidad, sin zoom.
        const distancia = 55;

        const animacionSalida = slideAnterior.animate(
          [
            {
              opacity: 1,
              transform: 'translateX(0)',
            },
            {
              opacity: 0,
              transform: `translateX(${-direccion * distancia}px)`,
            },
          ],
          {
            duration: duracion,
            easing: 'cubic-bezier(0.22, 1, 0.36, 1)',
            fill: 'both',
          }
        );

        const animacionEntrada = slideSiguiente.animate(
          [
            {
              opacity: 0,
              transform: `translateX(${direccion * distancia}px)`,
            },
            {
              opacity: 1,
              transform: 'translateX(0)',
            },
          ],
          {
            duration: duracion,
            easing: 'cubic-bezier(0.22, 1, 0.36, 1)',
            fill: 'both',
          }
        );

        function finalizar() {
          animacionSalida.cancel();
          animacionEntrada.cancel();

          slideAnterior.hidden = true;
          slideAnterior.classList.remove('grafico-saliendo');
          slideSiguiente.classList.remove('grafico-entrando');

          visor.style.removeProperty('height');
          animando = false;
        }

        Promise.all([
          animacionSalida.finished,
          animacionEntrada.finished,
        ]).then(finalizar).catch(finalizar);
      }

      prev?.addEventListener('click', () => mostrar(current - 1, -1));
      next?.addEventListener('click', () => mostrar(current + 1, 1));

      dots.forEach((dot, index) => {
        dot.addEventListener('click', () => {
          mostrar(index, index > current ? 1 : -1);
        });
      });

      // Permite deslizar entre gráficos en pantallas táctiles.
      visor.addEventListener(
        'touchstart',
        (event) => {
          touchStartX = event.changedTouches[0].screenX;
          touchStartY = event.changedTouches[0].screenY;
        },
        { passive: true }
      );

      visor.addEventListener(
        'touchend',
        (event) => {
          const diffX = event.changedTouches[0].screenX - touchStartX;
          const diffY = event.changedTouches[0].screenY - touchStartY;

          if (Math.abs(diffX) > 50 && Math.abs(diffX) > Math.abs(diffY)) {
            const direccion = diffX < 0 ? 1 : -1;
            mostrar(current + direccion, direccion);
          }
        },
        { passive: true }
      );

      actualizarControles();
    });
  }

  /* ==========================================
     INICIALIZACIÓN COMPATIBLE CON ASTRO
     ========================================== */

  function iniciarInteracciones() {
    iniciarCarruseles();
    iniciarCarruselGraficos();
  }

  iniciarInteracciones();

  document.addEventListener('astro:page-load', iniciarInteracciones);
</script>