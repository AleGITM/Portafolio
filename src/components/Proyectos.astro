<script>
  function iniciarCarruseles() {
    document.querySelectorAll<HTMLElement>('[data-tabs-root]').forEach((root) => {
      if (root.dataset.initialized === 'true') return;

      root.dataset.initialized = 'true';

      const tabs = Array.from(
        root.querySelectorAll<HTMLButtonElement>('[data-tab]')
      );

      const panels = Array.from(
        root.querySelectorAll<HTMLElement>('[data-panel]')
      );

      const counter = root.querySelector<HTMLElement>('[data-counter]');
      const prev = root.querySelector<HTMLButtonElement>('[data-prev]');
      const next = root.querySelector<HTMLButtonElement>('[data-next]');

      if (!tabs.length || tabs.length !== panels.length) return;

      let current = 0;

      function mostrar(index: number, focusTab = false) {
        current = (index + tabs.length) % tabs.length;

        tabs.forEach((tab, i) => {
          const active = i === current;

          tab.classList.toggle('is-active', active);
          tab.setAttribute('aria-selected', String(active));
          tab.tabIndex = active ? 0 : -1;

          if (active && focusTab) tab.focus();
        });

        panels.forEach((panel, i) => {
          panel.hidden = i !== current;
        });

        if (counter) {
          counter.textContent =
            `${String(current + 1).padStart(2, '0')} / ${String(tabs.length).padStart(2, '0')}`;
        }
      }

      tabs.forEach((tab, index) => {
        tab.addEventListener('click', () => mostrar(index));

        tab.addEventListener('keydown', (event) => {
          if (event.key === 'ArrowRight') {
            event.preventDefault();
            mostrar(current + 1, true);
          } else if (event.key === 'ArrowLeft') {
            event.preventDefault();
            mostrar(current - 1, true);
          } else if (event.key === 'Home') {
            event.preventDefault();
            mostrar(0, true);
          } else if (event.key === 'End') {
            event.preventDefault();
            mostrar(tabs.length - 1, true);
          }
        });
      });

      prev?.addEventListener('click', () => mostrar(current - 1));
      next?.addEventListener('click', () => mostrar(current + 1));

      mostrar(0);
    });
  }

  function iniciarCarruselGraficos() {
    document.querySelectorAll<HTMLElement>('[data-graficos-root]').forEach((root) => {
      if (root.dataset.initialized === 'true') return;

      root.dataset.initialized = 'true';

      const slides = Array.from(
        root.querySelectorAll<HTMLElement>('[data-grafico-slide]')
      );

      const dots = Array.from(
        root.querySelectorAll<HTMLButtonElement>('[data-grafico-dot]')
      );

      const counter = root.querySelector<HTMLElement>('[data-grafico-counter]');
      const prev = root.querySelector<HTMLButtonElement>('[data-grafico-prev]');
      const next = root.querySelector<HTMLButtonElement>('[data-grafico-next]');
      const visor = root.querySelector<HTMLElement>('.grafico-visor');

      if (!slides.length) return;

      let current = 0;
      let touchStartX = 0;
      let touchStartY = 0;

      function mostrar(index: number) {
        current = (index + slides.length) % slides.length;

        slides.forEach((slide, i) => {
          slide.hidden = i !== current;
        });

        dots.forEach((dot, i) => {
          const active = i === current;
          dot.classList.toggle('is-active', active);

          if (active) {
            dot.setAttribute('aria-current', 'true');
          } else {
            dot.removeAttribute('aria-current');
          }
        });

        if (counter) {
          counter.textContent =
            `${String(current + 1).padStart(2, '0')} / ${String(slides.length).padStart(2, '0')}`;
        }
      }

      prev?.addEventListener('click', () => mostrar(current - 1));
      next?.addEventListener('click', () => mostrar(current + 1));

      dots.forEach((dot, index) => {
        dot.addEventListener('click', () => mostrar(index));
      });

      visor?.addEventListener(
        'touchstart',
        (event) => {
          touchStartX = event.changedTouches[0].screenX;
          touchStartY = event.changedTouches[0].screenY;
        },
        { passive: true }
      );

      visor?.addEventListener(
        'touchend',
        (event) => {
          const diffX = event.changedTouches[0].screenX - touchStartX;
          const diffY = event.changedTouches[0].screenY - touchStartY;

          if (Math.abs(diffX) > 50 && Math.abs(diffX) > Math.abs(diffY)) {
            mostrar(current + (diffX < 0 ? 1 : -1));
          }
        },
        { passive: true }
      );

      mostrar(0);
    });
  }

  function iniciarInteracciones() {
    iniciarCarruseles();
    iniciarCarruselGraficos();
  }

  iniciarInteracciones();
  document.addEventListener('astro:page-load', iniciarInteracciones);
</script>