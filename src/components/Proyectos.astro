<script>
	// Dibuja un punto de neón con estela que recorre el contorno redondeado de la tarjeta
	const canvas = document.querySelector('.neon-canvas');
	const card = canvas ? canvas.parentElement : null;
	const sinMovimiento = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

	if (canvas && card && !sinMovimiento) {
		const ctx = canvas.getContext('2d');
		const PAD = 20; // margen extra del canvas (debe coincidir con el CSS)
		const RADIO = 16; // igual al border-radius de la tarjeta (1rem)
		const VUELTA = Number(canvas.dataset.vuelta) * 1000; // milisegundos por vuelta
		const LARGO_ESTELA = 130; // largo de la estela en píxeles
		const SEGMENTOS = 70; // tramos en que se divide la estela

		let w = 0;
		let h = 0;
		let total = 0;

		// Ajusta el canvas al tamaño actual de la tarjeta (también en pantallas retina)
		function medir() {
			const dpr = window.devicePixelRatio || 1;
			const ancho = card.offsetWidth + PAD * 2;
			const alto = card.offsetHeight + PAD * 2;
			canvas.width = ancho * dpr;
			canvas.height = alto * dpr;
			canvas.style.width = ancho + 'px';
			canvas.style.height = alto + 'px';
			ctx.setTransform(dpr, 0, 0, dpr, 0, 0);

			w = card.offsetWidth - 1;
			h = card.offsetHeight - 1;
			total = 2 * (w - 2 * RADIO) + 2 * (h - 2 * RADIO) + 2 * Math.PI * RADIO;
		}

		// Devuelve la posición [x, y] a una distancia d recorrida sobre el contorno
		function punto(d) {
			const r = RADIO;
			const lado = w - 2 * r;
			const alto = h - 2 * r;
			const arco = (Math.PI * r) / 2;
			d = ((d % total) + total) % total;

			if (d < lado) return [r + d, 0];
			d -= lado;
			if (d < arco) {
				const a = d / r;
				return [w - r + Math.sin(a) * r, r - Math.cos(a) * r];
			}
			d -= arco;
			if (d < alto) return [w, r + d];
			d -= alto;
			if (d < arco) {
				const a = d / r;
				return [w - r + Math.cos(a) * r, h - r + Math.sin(a) * r];
			}
			d -= arco;
			if (d < lado) return [w - r - d, h];
			d -= lado;
			if (d < arco) {
				const a = d / r;
				return [r - Math.sin(a) * r, h - r + Math.cos(a) * r];
			}
			d -= arco;
			if (d < alto) return [0, h - r - d];
			d -= alto;
			const a = d / r;
			return [r - Math.cos(a) * r, r - Math.sin(a) * r];
		}

		function dibujar(ahora) {
			ctx.clearRect(0, 0, canvas.width, canvas.height);
			ctx.save();
			// El contorno queda centrado sobre la línea del borde de la tarjeta
			ctx.translate(PAD + 0.5, PAD + 0.5);

			const cabeza = ((ahora % VUELTA) / VUELTA) * total;
			const paso = LARGO_ESTELA / SEGMENTOS;
			ctx.lineCap = 'butt';

			// Estela: de la cola (invisible) hacia el punto (más fuerte y gruesa)
			for (let i = SEGMENTOS - 1; i >= 0; i--) {
				const f = 1 - i / SEGMENTOS; // 1 junto al punto, 0 al final de la cola
				const [x1, y1] = punto(cabeza - (i + 1) * paso);
				const [x2, y2] = punto(cabeza - i * paso);

				ctx.beginPath();
				ctx.moveTo(x1, y1);
				ctx.lineTo(x2, y2);

				// Halo suave
				ctx.strokeStyle = `rgba(236, 72, 153, ${f * f * 0.25})`;
				ctx.lineWidth = 2 + f * 9;
				ctx.stroke();

				// Núcleo de la estela
				ctx.strokeStyle = `rgba(255, 110, 190, ${f * f})`;
				ctx.lineWidth = 0.8 + f * 3.2;
				ctx.stroke();
			}

			// Punto principal con brillo
			const [px, py] = punto(cabeza);
			ctx.shadowColor = '#ec4899';
			ctx.shadowBlur = 18;
			const degradado = ctx.createRadialGradient(px, py, 0, px, py, 8);
			degradado.addColorStop(0, '#ffffff');
			degradado.addColorStop(0.45, '#ff8fc8');
			degradado.addColorStop(1, '#ec4899');
			ctx.fillStyle = degradado;
			ctx.beginPath();
			ctx.arc(px, py, 7, 0, Math.PI * 2);
			ctx.fill();

			ctx.restore();
			requestAnimationFrame(dibujar);
		}

		medir();
		new ResizeObserver(medir).observe(card);
		requestAnimationFrame(dibujar);
	}
</script>