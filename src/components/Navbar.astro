---
// Enlaces a las páginas independientes del portafolio
const navLinks = [
	{ name: 'Inicio', href: '/' },
	{ name: 'Sobre mí', href: '/sobre_mi' },
	{ name: 'Proyectos', href: '/proyectos' },
	{ name: 'Contacto', href: '/contacto' },
];
---

<header class="sticky top-0 z-50 border-b border-pink-500/20 bg-slate-950">
	<nav class="mx-auto flex max-w-6xl items-center justify-between px-6 py-4">
		<a
			href="/"
			class="font-accent text-2xl text-white transition-colors hover:text-pink-400"
		>
			Ale<span class="text-pink-500">M</span>
		</a>

		<ul class="hidden items-center gap-8 md:flex">
			{
				navLinks.map((link) => (
					<li>
						<a
							href={link.href}
							class="font-accent text-xl text-gray-300 transition-colors hover:text-pink-400"
						>
							{link.name}
						</a>
					</li>
				))
			}
		</ul>

		<button
			id="menu-btn"
			type="button"
			class="text-2xl text-white md:hidden"
			aria-label="Abrir menú"
			aria-expanded="false"
			aria-controls="mobile-menu"
		>
			☰
		</button>
	</nav>

	<ul id="mobile-menu" class="hidden space-y-4 px-6 pb-4 md:hidden">
		{
			navLinks.map((link) => (
				<li>
					<a
						href={link.href}
						class="font-accent block text-xl text-gray-300 transition-colors hover:text-pink-400"
					>
						{link.name}
					</a>
				</li>
				))
			}
	</ul>
</header>

<script>
	const btn = document.getElementById('menu-btn');
	const menu = document.getElementById('mobile-menu');

	// Alterna el menú móvil y actualiza su estado accesible
	btn?.addEventListener('click', () => {
		const abierto = menu?.classList.toggle('hidden') === false;
		btn.setAttribute('aria-expanded', String(abierto));
	});
</script>